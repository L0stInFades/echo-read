<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景层。渐变三个色标全部取自 0.2.0 的 M3 调色板（seed #7C9BFF / SchemeTonalSpot）：
  primary T30 -> primary T40 -> tertiary T40，也就是应用内品牌渐变 rememberAurora() 的同一条色带。
  背景层必须铺满整个 108dp 画布：系统会按各家启动器的形状对它做遮罩。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF344479" />
                <item android:offset="0.55" android:color="#FF4C5C92" />
                <item android:offset="1" android:color="#FF745470" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
