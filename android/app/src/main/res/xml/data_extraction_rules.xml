<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 起的备份规则。云备份排除书库数据库，理由见 backup_rules.xml。
  换机时的设备间直传没有 25MB 配额，不加限制：书架与阅读进度跟着搬到新手机。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="echo-read.db" />
        <exclude domain="database" path="echo-read.db-shm" />
        <exclude domain="database" path="echo-read.db-wal" />
        <exclude domain="database" path="echo-read.db-journal" />
    </cloud-backup>
</data-extraction-rules>
